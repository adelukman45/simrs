          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.status === 'success' && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('jwt_token', res.data.token);",
                  "    pm.environment.set('jwt_token', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
